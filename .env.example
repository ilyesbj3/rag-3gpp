# Primary LLM: Google Gemini  (key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback LLM 1: Groq, free tier  (key: https://console.groq.com/keys, starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback LLM 2: xAI Grok  (key: https://console.x.ai, starts with xai-)
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Generation settings
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
